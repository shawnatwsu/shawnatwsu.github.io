---
import Shell from '../layouts/Shell.astro';
const studies=[
['Historical climate risk','Changing climate risks for high-value tree fruit production across the United States','A look at how climate conditions relevant to tree fruit have shifted across U.S. growing regions.','/media/map-6.webp','Changing-Climate-Risks-for-High-Value-Tree-Fruit-Production-across-the-United-States'],
['Climate projections','Projected changes in climate conditions affecting U.S. apple production','Large ensembles from CESM2 offer multiple realizations of a warming climate. Comparing those runs helps put shifts in growing conditions in the context of year-to-year variability.','/media/map-7.webp','Projected-Changes-in-Climate-Conditions-Affecting-U.S.-Apple-Production-Using-Large-Ensembles']];
---
<Shell title="Climate research" active="Research"><section class="wrap section"><small>ENVIRONMENTAL SCIENCE</small><h1>Climate research</h1><p class="intro">How do changing temperatures reshape the places where apples can grow?</p>{studies.map(([label,title,body,image,repo],i)=><article class="case"><figure><img src={image} alt={label+' figure for U.S. apple-growing regions'} loading="lazy"/></figure><div><small>{label}</small><h2>{title}</h2><p>{body}</p><div class="actions"><a href={'https://github.com/shawnatwsu/'+repo}>Research code ↗</a>{i===0 && <a href="https://www.researchgate.net/publication/385719286_Changing_climate_risks_for_high-value_tree_fruit_production_across_the_United_States">Read the study ↗</a>}</div></div></article>)}</section></Shell>
